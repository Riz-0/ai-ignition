# Copy to .env and fill in values before running the backend

PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# Hoot, the 2AM Assistant chat (routes/assistant.js) — Claude by Anthropic.
# Leave blank to use the app's on-device replies instead.
ANTHROPIC_API_KEY=

# LLM — used by conversationService to interpret customer intent
OPENAI_API_KEY=
# AWS_REGION=ap-southeast-1   # Uncomment to use Amazon Bedrock instead

# Marketplace adapter credentials (add when integrations are validated)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Messaging channels (future — start with in-app chat)
LINE_CHANNEL_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
