{
  "name": "The 2am Shoppers",
  "short_name": "2am Shoppers",
  "description": "One app for thoughtful shopping, savings goals and personalised customer conversations.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#08090f",
  "theme_color": "#f04e6e",
  "categories": ["shopping", "finance", "lifestyle"],
  "icons": [
    { "src": "/icon-192.png",           "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png",           "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png",  "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png",   "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Wishlist",   "url": "/customer/wishlist",    "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Savings",    "url": "/customer/savings",     "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Connections","url": "/customer/connections", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
